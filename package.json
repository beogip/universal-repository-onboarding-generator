{
  "name": "universal-repository-onboarding-generator",
  "version": "3.0.0",
  "description": "AI-powered tool that automatically analyzes repositories and creates tailored onboarding documentation",
  "main": "build/index.js",
  "bin": {
    "repository-onboarding-generator": "./bin/repository-onboarding-generator"
  },
  "scripts": {
    "build": "node build/build.js",
    "build:dev": "node build/build.js --dev",
    "watch": "node build/build.js --watch",
    "clean": "rm -f dist/repository-onboarding-generator.prompt.md",
    "dev": "yarn clean && yarn build:dev",
    "prod": "yarn clean && yarn build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ bin/ --ext .js",
    "lint:fix": "eslint src/ bin/ --ext .js --fix"
  },
  "keywords": [
    "onboarding",
    "documentation",
    "ai",
    "repository",
    "github-copilot",
    "developer-tools"
  ],
  "author": "Juan Gipponi",
  "license": "MIT",
  "devDependencies": {
    "chokidar": "^3.6.0",
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "mustache": "^4.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
